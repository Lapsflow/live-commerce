// Prisma Schema for Live-Commerce
// 6 Core Models + Center System + RateLimit

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────── User Management ────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique // ✨ 로그인용 아이디 (pptx 스펙)
  email        String?  @unique // ✨ 실제 이메일 (선택)
  name         String
  phone        String // ✨ 휴대폰번호 (필수 - pptx 스펙)
  role         Role     @default(SELLER)
  adminId      String?
  centerId     String? // ✨ Center assignment (nullable - MASTER has no center)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ✨ Seller 1차 정보 (회원가입 시)
  channels String[] @default([]) // 활동 채널 (예: ["GRIP", "CLME", "YOUTUBE"])
  avgSales Int? // 평균 매출 (월간 평균)

  // ✨ Seller 2차 정보 (가입 후 선택 입력 - pptx 스펙)
  categories String[] @default([]) // 주요 판매 카테고리
  regions    String[] @default([]) // 활동 지역
  timeSlots  String[] @default([]) // 방송 가능 시간대

  // ✨ Contract Approval Fields (Phase 1)
  contractStatus          ContractStatus @default(PENDING)
  contractApprovedAt      DateTime?
  contractApprovedBy      String? // Admin user ID
  contractRejectionReason String?

  // ✨ 활성/비활성 토글 (수정 요청 #3)
  isActive Boolean @default(true)

  // Self-referential relation: Admin → Sellers
  admin   User?  @relation("AdminSellers", fields: [adminId], references: [id], onDelete: SetNull)
  sellers User[] @relation("AdminSellers")

  // Center relation
  center Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  // Relations
  orders             Order[]               @relation
  adminOrders        Order[]               @relation("AdminOrders")
  broadcasts         Broadcast[]
  rejectedBroadcasts Broadcast[]           @relation("BroadcastRejecter")
  sales              Sale[]
  proposals          Proposal[]
  proposalCarts      ProposalCart[]
  sellerMatches      OrderSellerMatching[]
  scanLogs           ScanLog[]
  auditLogs          AuditLog[]
}

enum Role {
  MASTER
  SUB_MASTER
  ADMIN
  SELLER
}

enum ContractStatus {
  PENDING
  APPROVED
  REJECTED
}

// ──────────────────────── Product Management ────────────────────────

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  barcode       String   @unique
  sellPrice     Int // 권장 판매가
  supplyPrice   Int // 공급가
  originalPrice Int? // 원가 (본사: ONEWMS org_price, 센터: 등록자 입력)
  minSellPrice  Int? // 최소 판매가
  maxSellPrice  Int? // 최대 판매가
  totalStock    Int      @default(0)
  reservedStock Int      @default(0) // ✨ 선점된 재고 수량 (발주 시 증가, 입금/취소 시 감소)
  stockMujin    Int      @default(0)
  stock1        Int      @default(0)
  stock2        Int      @default(0)
  stock3        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ✨ ONEWMS Integration Fields
  onewmsCode    String? @unique // ONEWMS 상품코드
  onewmsBarcode String? // ONEWMS 바코드

  // ✨ Multi-Warehouse Fields
  masterBarcodeId String? // 공식 바코드 마스터 ID

  // ✨ Phase 2: Product Type Separation
  productType  ProductType @default(HEADQUARTERS) // WMS(본사) vs CENTER(센터)
  managedBy    String? // centerId for CENTER products, null for HEADQUARTERS
  isWmsProduct Boolean     @default(true) // true for HEADQUARTERS, false for CENTER

  // ✨ 센터 상품 등록 관리
  category     String? // 카테고리 (식품/뷰티/생활/가전/패션/기타)
  registeredBy String? // 등록한 사용자 ID (CENTER 상품)
  notes        String? // 메모

  // ✨ PRODUCT-05: Soft delete (비활성화만, hard delete 금지)
  isActive Boolean @default(true)

  // ✨ Phase 3: Sample Shopping Mall
  isSample       Boolean         @default(false)
  sampleCategory SampleCategory?
  samplePrice    Int? // null=비공개, 0=무료, >0=유료
  sampleStatus   SampleStatus?

  // Relations
  orderItems           OrderItem[]
  sales                Sale[]
  onewmsStocks         OnewmsStockSync[]
  warehouseInventories WarehouseInventory[]
  stockMovements       StockMovement[]
  centerStocks         ProductCenterStock[] // ✨ Center-based stock normalization
  sellerMatches        OrderSellerMatching[]
  aiAnalyses           AIAnalysis[] // ✨ AI Analysis results
  proposalCarts        ProposalCart[]
  scanLogs             ScanLog[]
  reservations         StockReservation[] // ✨ 재고 선점 이력

  @@index([productType])
  @@index([managedBy])
  @@index([isActive])
}

enum ProductType {
  HEADQUARTERS // WMS 본사 관리 - 바코드 필수, 가격 읽기전용
  CENTER // 센터 자사몰 - 바코드 선택, 가격 수정가능
}

enum SampleCategory {
  LIVING // 생활용품
  FOOD // 식품
  GENERAL // 잡화
  CLOTHING // 의류
  BABY // 유아
  PET // 애견
  BEAUTY // 뷰티
  HEALTH // 건강
  OTHER // 기타
}

enum SampleStatus {
  CONTINUOUS // 꾸준한 제품
  UNTIL_SOLD // 소진후 종료
}

// ──────────────────────── Center Management ────────────────────────

model Center {
  id         String @id @default(cuid())
  code       String @unique // 센터코드 (예: "01-4213" = 지역코드-대표자폰번호뒷자리)
  name       String // 센터명
  regionCode String // 지역코드 ("01"~"17": 서울~제주)
  regionName String // 지역명 (서울, 경기, 인천, etc.)

  // 대표자 정보
  representative      String // 대표자 이름
  representativePhone String // 대표자 연락처

  // 사업장 정보
  address       String // 주소
  addressDetail String? // 상세주소
  businessNo    String? // 사업자등록번호

  // 계약 정보
  contractDate     DateTime? // 계약일
  contractDocument String? // 계약서 파일 경로

  // ✨ 내부 관리용
  centerNumber   String? // 순차 번호 (C01, C02, ...) - 내부 관리용
  isMasterCenter Boolean @default(false) // 본사 센터 여부

  // 상태
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  centerStocks ProductCenterStock[]
  orders       Order[]
  broadcasts   Broadcast[]
  scanLogs     ScanLog[]

  @@index([code])
  @@index([regionCode])
  @@index([isActive])
}

model ProductCenterStock {
  id        String   @id @default(cuid())
  productId String
  centerId  String
  stock     Int      @default(0) // 센터별 재고
  location  String? // 센터 내 위치 (예: "1층", "2층")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  center  Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([productId, centerId])
  @@index([productId])
  @@index([centerId])
}

model OrderSellerMatching {
  id          String   @id @default(cuid())
  orderId     String
  sellerId    String
  productId   String
  matchedAt   DateTime @default(now())
  matchReason String? // 매칭 이유 (예: "frequent_buyer", "first_time", etc.)

  // RFM 데이터
  orderCount    Int      @default(1) // 해당 상품 주문 횟수
  totalQuantity Int      @default(0) // 총 주문 수량
  totalRevenue  Int      @default(0) // 총 주문 금액
  lastOrderAt   DateTime @default(now())

  // 추천 스코어 (0-100)
  recommendScore Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sellerId, productId])
  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
  @@index([recommendScore])
}

// ──────────────────────── Order Management ────────────────────────

model Order {
  id                 String      @id @default(cuid())
  orderNo            String      @unique
  sellerId           String
  adminId            String?
  processingCenterId String? // ✨ Center processing this order (nullable)
  status             OrderStatus @default(PENDING)
  totalAmount        Int         @default(0)
  memo               String?
  uploadedAt         DateTime    @default(now())
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // ✨ 수령자 정보 (Excel 업로드용)
  recipient String? // 수령자
  phone     String? // 연락처
  address   String? // 주소

  // ✨ 금액 정보
  totalMargin Int @default(0) // 총 마진

  // ✨ 입금/출고 상태 추적
  paymentStatus  PaymentStatus  @default(UNPAID)
  shippingStatus ShippingStatus @default(PENDING)
  paidAt         DateTime? // 입금 완료 시각

  // ✨ 가상계좌 정보 (Toss Payments)
  virtualAccount       String? // 가상계좌 번호
  virtualAccountBank   String? // 은행명 (예: "KB", "신한")
  virtualAccountExpiry DateTime? // 가상계좌 만료 시각

  // ✨ Phase 2: Product Type for Auto-Split
  productType ProductType? // HEADQUARTERS or CENTER (null for mixed orders)

  // ✨ 재고 선점 자동화 (PDF 스펙 7페이지)
  expiresAt    DateTime? // 입금 마감 시각 (생성 + 3시간)
  cancelledAt  DateTime? // 취소 시각
  cancelReason String? // "EXPIRED" | "SELLER_CANCELLED" | "ADMIN_CANCELLED"

  // ✨ LIVE-03: 발주서→방송 자동 매칭
  broadcastId String? // 매칭된 방송 ID (자동 또는 수동)
  matchType   String? // "AUTO" | "MANUAL" | null(미매칭)

  // ✨ ORDER-04: 세금계산서 발행
  taxInvoiceIssued   Boolean   @default(false)
  taxInvoiceIssuedAt DateTime?
  taxInvoiceNumber   String? // 세금계산서 번호

  // Relations
  seller             User                  @relation(fields: [sellerId], references: [id])
  admin              User?                 @relation("AdminOrders", fields: [adminId], references: [id])
  processingCenter   Center?               @relation(fields: [processingCenterId], references: [id], onDelete: SetNull)
  broadcast          Broadcast?            @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  onewmsMapping      OnewmsOrderMapping?
  onewmsDeliveryLogs OnewmsDeliveryLog[]
  sellerMatches      OrderSellerMatching[]
  reservations       StockReservation[] // ✨ 재고 선점 이력

  // Indexes
  @@index([sellerId, uploadedAt])
  @@index([orderNo])
  @@index([paymentStatus, shippingStatus])
  @@index([productType])
  @@index([expiresAt, paymentStatus, status]) // ✨ cron 만료 조회 최적화
  @@index([broadcastId]) // ✨ LIVE-03: 방송별 발주 조회
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // ✨ Soft cancel (hard delete 금지)
}

enum PaymentStatus {
  UNPAID // 입금확인전
  PAID // 입금완료
  PAYMENT_FAILED // 가상계좌 발급 실패
}

enum ShippingStatus {
  PENDING // 대기
  PREPARING // 발송준비
  SHIPPED // 출고완료
  PARTIAL // 부분출고
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  // ✨ Excel 업로드용 스냅샷 필드
  barcode     String // 바코드
  productName String // 상품명
  supplyPrice Int // 공급가 (개당)
  totalSupply Int // 공급가 합계 = supplyPrice × quantity
  margin      Int // 마진 = (입금액 / 수량) - supplyPrice

  // ✨ Phase 2: Product Type Snapshot
  productType ProductType @default(HEADQUARTERS) // Copied from product at creation

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Indexes
  @@index([orderId])
  @@index([productId])
  @@index([productType])
}

// ──────────────────────── Stock Reservation (PDF 스펙 7페이지) ────────────────────────

model StockReservation {
  id          String            @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int // 선점 수량
  status      ReservationStatus @default(ACTIVE)
  reservedAt  DateTime          @default(now())
  releasedAt  DateTime?
  releaseType String? // "PAYMENT_CONFIRMED" | "CANCELLED" | "EXPIRED"

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId, status])
}

enum ReservationStatus {
  ACTIVE // 선점 중
  CONVERTED // 입금 확인 → 재고 차감 완료
  RELEASED // 취소 또는 만료
}

// ──────────────────────── Broadcast Management ────────────────────────

model Broadcast {
  id               String            @id @default(cuid())
  code             String            @unique
  sellerId         String
  centerId         String? // ✨ Center for this broadcast (nullable)
  platform         BroadcastPlatform
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  status           BroadcastStatus   @default(SCHEDULED)
  memo             String?
  requestMemo      String? // 셀러 신청 메모
  rejectionReason  String? // 반려 사유
  rejectedAt       DateTime? // 반려 시각
  rejectedBy       String? // 반려한 사용자 ID
  reminder1hSentAt DateTime? // 1시간 전 리마인더 발송 시각 (중복 방지)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  seller   User    @relation(fields: [sellerId], references: [id])
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)
  rejecter User?   @relation("BroadcastRejecter", fields: [rejectedBy], references: [id], onDelete: SetNull)
  sales    Sale[]
  orders   Order[] // ✨ LIVE-03: 매칭된 발주서들
}

enum BroadcastPlatform {
  GRIP
  CLME
  YOUTUBE
  TIKTOK
  BAND
  OTHER
}

enum BroadcastStatus {
  REQUESTED // 셀러가 신청
  SCHEDULED // 관리자 승인 → 확정
  LIVE // 방송 진행중
  ENDED // 방송 종료
  CANCELED // 취소
  REJECTED // 관리자 반려
}

// ──────────────────────── Sales Management ────────────────────────

model Sale {
  id          String   @id @default(cuid())
  saleNo      String   @unique
  sellerId    String
  productId   String
  broadcastId String?
  quantity    Int
  unitPrice   Int
  totalPrice  Int
  saleDate    DateTime @default(now())
  createdAt   DateTime @default(now())

  // Relations
  seller    User       @relation(fields: [sellerId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
}

// ──────────────────────── Proposal Management ────────────────────────

model Proposal {
  id          String         @id @default(cuid())
  companyName String
  contact     String
  phone       String
  productName String
  category    String
  subcategory String? // ✨ PROPOSAL-04: 소분류 카테고리
  description String
  status      ProposalStatus @default(PENDING)
  submittedBy String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // ✨ PROPOSAL-06: 상품 이미지
  imageMain String? // 메인 썸네일 URL
  imageSubs String? // 서브 이미지 URLs (JSON 배열, 최대 5장)

  // ✨ PROPOSAL-06: 샘플 정책
  sampleType    String? // "FREE" | "PAID"
  samplePrice   Int? // 유료 시 샘플 가격
  quantityLimit Int? // 센터별 수량 제한

  // ✨ PROPOSAL-06: 공급 정책
  supplyType String? // "SINGLE" | "RECURRING"
  brand      String? // 브랜드명

  // ✨ PROPOSAL-06: 연관 상품코드
  productCode String? // 본사 상품 코드 (예: [33])

  user User @relation(fields: [submittedBy], references: [id])

  @@index([status])
  @@index([submittedBy])
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProposalCart {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  quantity    Int      @default(1)
  samplePrice Int      @default(0) // 샘플가 (무료=0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ──────────────────────── ONEWMS Integration ────────────────────────

model OnewmsOrderMapping {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  onewmsOrderNo String  @unique // ONEWMS 주문번호
  transNo       String? // 송장번호

  status     String @default("pending") // pending, sent, shipped, failed
  csStatus   Int    @default(0) // ONEWMS CS상태
  holdStatus Int    @default(0) // ONEWMS 보류상태

  sentAt       DateTime? // ONEWMS 전송 시각
  lastSyncAt   DateTime? // 마지막 동기화 시각
  errorMessage String? // 에러 메시지
  retryCount   Int       @default(0) // 재시도 횟수

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onewmsOrderNo])
  @@index([status])
  @@index([sentAt])
}

model OnewmsStockSync {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productCode  String // ONEWMS 상품코드
  availableQty Int // ONEWMS 가용재고
  totalQty     Int // ONEWMS 총재고
  localQty     Int // 플랫폼 재고

  difference Int // 차이 (ONEWMS - Local)
  syncStatus String @default("synced") // synced, conflict, failed

  syncedAt DateTime @default(now())

  @@index([productId])
  @@index([syncedAt])
}

model OnewmsDeliveryLog {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  oldStatus String? // 이전 배송 상태
  newStatus String // 새로운 배송 상태
  transNo   String? // 송장번호

  changedAt  DateTime @default(now())
  syncedFrom String   @default("onewms") // onewms, manual, system

  @@index([orderId])
  @@index([changedAt])
}

// ──────────────────────── Multi-Warehouse System ────────────────────────

model Warehouse {
  id            String    @id @default(cuid())
  code          String    @unique // 한국무진, 쓰리백, 거래처2, etc.
  name          String // Display name
  type          String // OWNED, PARTNER, EXTERNAL
  spreadsheetId String? // Google Spreadsheet ID
  sheetName     String? // Sheet name in spreadsheet
  syncEnabled   Boolean   @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  inventories        WarehouseInventory[]
  stockMovementsFrom StockMovement[]      @relation("FromWarehouse")
  stockMovementsTo   StockMovement[]      @relation("ToWarehouse")

  @@index([code])
}

model BarcodeMaster {
  id             String   @id @default(cuid())
  barcode        String   @unique
  standardName   String // Official product name
  category       String?
  manufacturer   String?
  specifications String? // JSON string for specs
  isActive       Boolean  @default(true)
  registeredBy   String // userId who registered
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  inventories WarehouseInventory[]

  @@index([barcode])
  @@index([isActive])
}

model WarehouseInventory {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  barcode     String // Denormalized for quick lookup
  quantity    Int      @default(0)
  location    String? // 무진, 1층, 2층, 3층, etc.
  lastUpdated DateTime @default(now())
  syncedFrom  String? // Source: SPREADSHEET, API, MANUAL

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodeMaster BarcodeMaster? @relation(fields: [barcode], references: [barcode], onDelete: SetNull)

  @@unique([warehouseId, productId])
  @@index([barcode])
  @@index([warehouseId])
  @@index([productId])
}

model StockMovement {
  id              String   @id @default(cuid())
  type            String // IN, OUT, TRANSFER, ADJUSTMENT
  productId       String
  barcode         String
  fromWarehouseId String?
  toWarehouseId   String?
  quantity        Int
  reason          String?
  reference       String? // Order ID, adjustment ID, etc.
  processedBy     String // userId
  processedAt     DateTime @default(now())

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse   Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([barcode])
  @@index([productId])
  @@index([processedAt])
}

// ──────────────────────── AI Analysis ────────────────────────

model AIAnalysis {
  id            String   @id @default(cuid())
  productId     String
  barcode       String
  analysisType  String // "pricing" | "sales"
  prompt        String   @db.Text
  response      String   @db.Text
  parsedData    Json
  tokensUsed    Int
  estimatedCost Float // USD
  modelVersion  String
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@index([createdAt])
}

model AIUsageStats {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  totalRequests Int      @default(0)
  totalTokens   Int      @default(0)
  totalCost     Float    @default(0)
}

// ──────────────────────── Rate Limiting ────────────────────────

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ──────────────────────── Market Pricing ────────────────────────

model MarketPricing {
  id          String   @id @default(cuid())
  barcode     String
  platform    String // "naver" | "coupang"
  productName String
  productUrl  String?
  minPrice    Int
  maxPrice    Int
  avgPrice    Int
  priceCount  Int // Number of listings found
  fetchedAt   DateTime @default(now())

  @@index([barcode, platform])
  @@index([fetchedAt])
}

// ──────────────────────── Barcode Scanner System ────────────────────────

model ScanLog {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  barcode   String
  scanType  ScanType
  quantity  Int?
  centerId  String?
  scannedAt DateTime @default(now())
  metadata  Json?

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  center  Center?  @relation(fields: [centerId], references: [id], onDelete: SetNull)

  @@index([userId, scannedAt])
  @@index([barcode])
  @@index([productId])
  @@index([centerId, scannedAt(sort: Desc)])
}

enum ScanType {
  INBOUND
  OUTBOUND
  LOOKUP
}

// ──────────────────────── Notification Log ────────────────────────

model NotificationLog {
  id          String   @id @default(cuid())
  type        String // "ORDER_CONFIRMED" | "BROADCAST_CANCELLED" | "SAMPLE_PAID"
  recipient   String // phone or email
  channel     String // "SMS" | "ALIMTALK" | "EMAIL"
  content     String
  status      String // "SENT" | "FAILED" | "MOCK"
  orderId     String?
  broadcastId String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([orderId])
  @@index([broadcastId])
}

// ──────────────────────── Audit Log ────────────────────────

model AuditLog {
  id String @id @default(cuid())

  // 누가
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole Role?
  userName String?

  // 무엇을
  action     AuditAction
  entityType String // "User" | "Product" | "Order" | "Broadcast" | "Center"
  entityId   String?
  entityName String?

  // 어떻게 바꿨는지
  before Json?
  after  Json?
  diff   Json?

  // 요청 컨텍스트
  ipAddress String?
  userAgent String?

  // 설명 및 메타데이터
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ROLE_CHANGED
  PERMISSION_DENIED
  EXPORT
  IMPORT
  PASSWORD_CHANGED
  STATUS_CHANGED
}
