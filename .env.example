# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ONEWMS-FMS API
ONEWMS_PARTNER_KEY="your-partner-key"
ONEWMS_DOMAIN_KEY="your-domain-key"
ONEWMS_API_URL="https://api.onewms.co.kr/api.php"
ONEWMS_SHOP_ID="usermanual"                 # P0: 판매처코드 (set_orders API 필수) — pnpm tsx scripts/onewms-bootstrap-shop.ts 실행 후 확인

# Vercel Cron Protection
CRON_SECRET="generate-with-openssl-rand-base64-32"

# AI Service (Google Gemini)
GEMINI_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"           # optional, default: gemini-2.5-flash
GEMINI_MAX_TOKENS="2048"                   # optional, default: 2048

# Naver Shopping API
NAVER_CLIENT_ID="your-naver-client-id"
NAVER_CLIENT_SECRET="your-naver-client-secret"

# Toss Payments (가상계좌)
TOSS_SECRET_KEY="test_sk_..."
TOSS_CLIENT_KEY="test_ck_..."

# ── Phase 2: External API Adapters ──

# Notification Service (Solapi)
NOTIFICATION_PROVIDER="mock"            # mock | solapi
SOLAPI_API_KEY="your-solapi-api-key"
SOLAPI_API_SECRET="your-solapi-api-secret"
SOLAPI_SENDER_PHONE="01012345678"       # 사전 등록 필수
SOLAPI_PFID="your-kakao-channel-pfid"
ADMIN_ALERT_PHONE="01000000000"       # 알림 장애 시 관리자 연락처

# Tax Invoice (PopBill - Primary)
TAX_INVOICE_PROVIDER="mock"             # mock | popbill | barobill
POPBILL_LINK_ID="your-popbill-link-id"
POPBILL_SECRET_KEY="your-popbill-secret"
POPBILL_CORP_NUM="1234567890"           # 사업자등록번호 (하이픈 없이)
POPBILL_IS_TEST="true"

# Tax Invoice (Barobill - Backup)
BAROBILL_CERT_KEY="your-barobill-cert-key"
BAROBILL_CORP_NUM="1234567890"
BAROBILL_ID="your-barobill-id"
BAROBILL_IS_TEST="true"

# Company Info (세금계산서 공급자 정보)
COMPANY_CORP_NUM="0000000000"
COMPANY_NAME="슈퍼무진"
COMPANY_CEO="대표자"
COMPANY_ADDR=""
COMPANY_BIZ_TYPE="도소매"
COMPANY_BIZ_CLASS="전자상거래"
COMPANY_EMAIL=""
